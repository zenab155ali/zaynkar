# Copy this file to ".env.local" (same folder) and fill in your real values.
# Find them in your Supabase project: Project Settings -> API.
# .env.local is already in .gitignore — it will never be committed or deployed publicly by accident,
# but note the anon key is designed to be safe in a public, client-side app (Row Level Security does the real protecting).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: only needed if your admin account in Supabase uses a real email address
# instead of the default placeholder (zenabkareem@zaynkar-admin.internal). See
# supabase/README.md. This stays private to your computer — never committed.
VITE_ADMIN_EMAIL=
